// Tugeelt.mn - Prisma Schema
// Maps to existing MySQL database: tugeeltm_db

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Product {
  id          Int       @id @default(autoincrement())
  kod         String    @unique @db.VarChar(100)
  title       String    @db.VarChar(500)
  body        String?   @db.LongText
  image       String?   @db.VarChar(255)
  une         Int       @default(0)
  unehuuchin  Int       @default(0)
  ontsloh     Int       @default(0)
  duussan     Int       @default(0)
  comments    Int       @default(0)
  video       String?   @db.VarChar(500)
  hurgelt     Int       @default(0)
  catvars     String?   @db.VarChar(500)
  options     String?   @db.Text
  nemsen      Int       @default(0)
  publish     Int       @default(1)
  uldegdel    Int       @default(0)
  photos      Photo[]
  cartItems   CartItem[]
  productComments Comment[]
  favorites   Favorite[]

  @@index([publish])
  @@index([ontsloh])
  @@index([une])
  @@index([nemsen])
  @@index([publish, catvars])
  @@map("srcms_baraa")
}

model Photo {
  id          Int     @id @default(autoincrement())
  bid         Int
  image       String  @db.VarChar(255)
  name        String? @db.VarChar(255)
  mainphoto   Int     @default(0)
  product     Product @relation(fields: [bid], references: [id])

  @@map("srcms_photos")
}

model Category {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  cat         Int       @default(0)
  image       String?   @db.VarChar(255)
  publish     Int       @default(1)
  list_order  Int       @default(0)

  @@map("srcms_cats")
}

model CartItem {
  id      Int     @id @default(autoincrement())
  sesid   String  @db.VarChar(100)
  bid     Int
  hed     Int     @default(1)
  songolt String? @db.VarChar(255)
  ognoo   Int     @default(0)
  product Product @relation(fields: [bid], references: [id])

  @@map("srcms_cart")
}

model CartDelivery {
  id      Int     @id @default(autoincrement())
  sesid   String  @db.VarChar(100)
  gazar   Int     @default(0)
  une     Int     @default(0)

  @@map("srcms_cart2")
}

model Order {
  id              Int     @id @default(autoincrement())
  zid             Int     @unique
  sesid           String  @map("userid") @db.VarChar(100)
  ner             String? @db.VarChar(255)
  utas1           String? @db.VarChar(50)
  utas2           String? @db.VarChar(50)
  ognoo           String? @db.VarChar(50)
  tsag            String? @map("avahtsag") @db.VarChar(50)
  hayag           String? @db.Text
  comment         String? @db.Text
  tolbor_helber   String? @default("1") @db.VarChar(200)
  noat            String? @map("noat_avah") @default("0") @db.VarChar(10)
  niitdun         String? @db.VarChar(50)
  tolov           String? @default("0") @db.VarChar(10)
  tolbor_tolson   String  @default("no") @db.VarChar(10)
  ajiltan         String? @default("0") @db.VarChar(30)
  ognoo2          String? @default("0") @db.VarChar(100)
  details         OrderDetail[]

  @@map("srcms_zahialga")
}

model OrderDetail {
  id      Int     @id @default(autoincrement())
  zid     Int
  bid     Int
  title   String? @map("ner") @db.VarChar(500)
  kod     String? @db.VarChar(100)
  hed     Int     @map("shirheg") @default(1)
  une     Int     @default(0)
  songolt String? @db.VarChar(255)
  order   Order   @relation(fields: [zid], references: [zid])

  @@map("srcms_zahialga_details")
}

model User {
  id          Int       @id @default(autoincrement())
  ner         String    @db.VarChar(255)
  email       String    @unique @db.VarChar(255)
  pass        String    @map("password") @db.VarChar(255)
  huis        Int       @default(0)
  birthday    String?   @db.VarChar(20)
  utas        String?   @db.VarChar(50)
  utas2       String?   @db.VarChar(50)
  hayag       String?   @db.Text
  image       String?   @db.VarChar(255)
  active      Int       @default(0)
  active_kod  String?   @db.VarChar(20)
  hyamdral    Int       @default(0)
  ajiltan     Int       @default(0)
  torol       Int       @default(0)
  regognoo    Int       @default(0)
  comments    Comment[]
  favorites   Favorite[]

  @@map("srcms_users")
}

model Banner {
  id        Int     @id @default(autoincrement())
  cat       Int     @default(1)
  title     String? @db.VarChar(255)
  image     String? @db.VarChar(255)
  holboos   String? @db.VarChar(500)
  publish   Int     @default(1)

  @@map("srcms_banners")
}

model Comment {
  id        Int     @id @default(autoincrement())
  bid       Int
  userid    Int     @default(0)
  ner       String? @db.VarChar(255)
  comment   String? @db.Text
  replyid   Int     @default(0)
  ipadd     String? @db.VarChar(50)
  ognoo     Int     @default(0)
  product   Product @relation(fields: [bid], references: [id])
  user      User?   @relation(fields: [userid], references: [id])

  @@map("srcms_comments")
}

model DeliveryZone {
  id      Int     @id @default(autoincrement())
  title   String  @db.VarChar(255)
  une     Int     @default(0)
  unegui  Int     @default(0)

  @@map("srcms_hurgelt_une")
}

model Page {
  id          Int     @id @default(autoincrement())
  title       String  @db.VarChar(255)
  purl        String  @unique @db.VarChar(100)
  body        String? @db.LongText
  publish     Int     @default(1)
  list_order  Int     @default(0)

  @@map("srcms_pages")
}

model Lang {
  id        Int     @id @default(autoincrement())
  tulhuur   String  @unique @db.VarChar(100)
  mn        String? @db.Text

  @@map("srcms_lang")
}

model OnlineUser {
  id      Int     @id @default(autoincrement())
  sesid   String  @db.VarChar(100)
  ognoo   Int     @default(0)
  userid  Int     @default(0)

  @@map("srcms_online_users")
}

model QpayLog {
  id          Int     @id @default(autoincrement())
  ognoo       Int     @default(0)
  ognoo2      String? @db.VarChar(20)
  dugaar      Int     @default(0)
  dun         Int     @default(0)
  tolov       Int     @default(0)
  tolov_code  String? @db.VarChar(10)
  invoice_id  String? @db.VarChar(255)
  qrcode      String? @db.Text
  qrimage     String? @map("qrcodeimage") @db.LongText
  ipadd       String? @db.VarChar(50)
  batalgaa    Int     @default(0)

  @@map("qpay_logs")
}

model GolomtLog {
  id          Int     @id @default(autoincrement())
  ognoo       Int     @default(0)
  ognoo2      String? @db.VarChar(20)
  dugaar      Int     @default(0)
  dun         Int     @default(0)
  tolov       Int     @default(0)
  tolov_code  String? @db.VarChar(10)
  ipadd       String? @db.VarChar(50)
  batalgaa    Int     @default(0)

  @@map("golomt_logs")
}

model HipayLog {
  id                  Int     @id @default(autoincrement())
  ognoo               Int     @default(0)
  ognoo2              String? @db.VarChar(20)
  dugaar              Int     @default(0)
  dun                 Int     @default(0)
  tolov               Int     @default(0)
  tolov_code          String? @db.VarChar(10)
  tolov_description   String? @db.VarChar(255)
  checkoutid          String? @db.VarChar(255)
  paymentid           String? @db.VarChar(255)
  ipadd               String? @db.VarChar(50)

  @@map("hipay_logs")
}

model LendmnLog {
  id          Int     @id @default(autoincrement())
  ognoo       Int     @default(0)
  ognoo2      String? @db.VarChar(20)
  dugaar      Int     @default(0)
  dun         Int     @default(0)
  tolov       Int     @default(0)
  tolov_code  String? @db.VarChar(10)
  invoice_id  String? @db.VarChar(255)
  ipadd       String? @db.VarChar(50)
  batalgaa    Int     @default(0)

  @@map("lendmn_logs")
}

model Admin {
  id        Int     @id @default(autoincrement())
  username  String  @unique @map("name") @db.VarChar(100)
  password  String  @db.VarChar(255)
  level     Int     @default(2)
  perm      String? @map("permission") @db.Text

  @@map("srcms_admins")
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(255)
  message   String?  @db.Text
  type      String   @default("info") @db.VarChar(50)
  isRead    Boolean  @default(false)
  link      String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  @@map("srcms_notifications")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userid    Int      @default(0) // 0 means guest or use sesid for guests
  sesid     String?  @db.VarChar(100)
  bid       Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [bid], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userid], references: [id], onDelete: Cascade)

  @@map("srcms_favorites")
}
